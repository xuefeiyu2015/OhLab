%Tgt on time correction for Robin0728
OffSetTime = 55;%in ms
OffSetBin = 55;
if ismember(fileNamePack,{'Robin072823DS1.mat','Robin072823MEMSAC1.mat','Robin072823RFMAP1.mat','Robin072823FRACSAC1.mat','Robin072823FLEXVAL1.mat','Robin072823OneDR1.mat'})
    if ismember(fileNamePack,'Robin072823FRACSAC1.mat')
        EndTrialNo = 80;
    elseif ismember(fileNamePack,'Robin072823MEMSAC1.mat')
        EndTrialNo = 28;
    elseif ismember(fileNamePack,'Robin072823FLEXVAL1.mat')
        EndTrialNo = 120;

    elseif ismember(fileNamePack,'Robin072823OneDR1.mat')

        EndTrialNo = 90;

     elseif ismember(fileNamePack,'Robin072823RFMAP1.mat')
         EndTrialNo = 80;


      elseif ismember(fileNamePack,'Robin072823DS1.mat')
          EndTrialNo = 240;



    end
    %{
curr_event_sel = GoodData.EventChannel(1,:)==TGTCD;

  A=  GoodData.EventTimeChannel(1,curr_event_sel) ;
    %}
    for i = 1:EndTrialNo
        event = TGTCD;
        curr_event_sel = GoodData.EventChannel(i,:)==event;
        GoodData.EventTimeChannel(i,curr_event_sel) = GoodData.EventTimeChannel(i,curr_event_sel)+OffSetTime;
        GoodData.EventBin(i,curr_event_sel) = GoodData.EventBin(i,curr_event_sel)+OffSetBin;
        


    end
    disp('TgtOnset corrected');
    
 
end
%{
if ismember(fileNamePack,{'Robin072823DS1.rst','Robin072823MEMSAC1.rst','Robin072823RFMAP1.rst','Robin072823FRACSAC1.rst','Robin072823FLEXVAL1.rst','Robin072823OneDR1.rst'})



end
