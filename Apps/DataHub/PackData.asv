function x=FillInBlink(x_ori);
    ScreenRange=40;
    x=x_ori;
    x(abs(x)>ScreenRange)=NaN;
    
       
end
function x=EventMatch(event_one,event_two)
x=NaN*ones(1,length(event_one));
  for i=1:length(event_one)
      x(i)=ismember(event_one(i),event_two);
      %Occurance check if match
      if x(i)==1
         OccNum_one=sum(event_one==event_one(i));
        OccNum_two=sum(event_two==event_one(i));
        if OccNum_one~=OccNum_two
              x(i)=0;
        end
      end
      
 
  end

end

