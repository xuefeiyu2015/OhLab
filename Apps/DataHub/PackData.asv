function [GoodData, AllData]= PackData(Raw,dataPathPacked,fileNamePack)
%This function is to pack data to a easier handle file; Xuefei Yu 08052019
% Screen all the successful trials;Usually it's the last trial among those
% with the same trial ID, unless the last trial is manually stoped by the
% researcher;
% Add Plexon/V probe Data Loading and packing; Xuefei Yu 12112020 
PlexonDataFolder='PlexonData';
PlexonParsedDataFolder='ParsedData';

try
ECode;
%Load the event database
EventCodeForAll=Raw.EventCode;
EventTimeForAll=Raw.EventTime;

%The time for event code "ENABLE" is exactly the same as the trial start time in Raw.TrlTime;
%Load the spike database from Blip
SpikeTime=Raw.SpkTime;

TrialTime=Raw.TrlTime;
TrialEndTime=TrialTime(:,2);

%Remove empty trials

ImageAssociationIndex=0;
%TaskCode and TaskName
%TaskCode =unique(cell2mat(cellfun(@(x) x(2), EventCodeForAll, 'UniformOutput', false)));
TaskCode =unique(cell2mat(cellfun(@(x) x(x>=300 & x<=400), EventCodeForAll, 'UniformOutput', false)));
if length(TaskCode)>1
    disp('More than one task detected in one file')
    return
end

TrialInform=Raw.Header;
TaskNameFinding=find(TrialInform==';');
TaskName=TrialInform(TaskNameFinding(end-1):TaskNameFinding(end));
TaskName=TaskName(2:end-1);

%TrialCode
TrialIndexBlip=cell2mat(cellfun(@(x) x(find(x>=TRIAL_ID & x<=TRIAL_ID*2-1,1,'first')), EventCodeForAll, 'UniformOutput', false))-TRIAL_ID;


%Reorganize the temporal sequence
EyeDataRaw=Raw.AnalogAmp;
EyeDataTime=Raw.AnalogTime;
EyeStartRecordTime=EyeDataTime(:,1);%Here I use the eye start record time as the common start time to align the data;

EyeStopRecordTime=EyeDataTime(:,2);

SamplingRate=Raw.AnalogSRate/1000;%%from Hz into /ms;

%Spike time end
SpikeTimeEnd=TrialEndTime-EyeStartRecordTime;


%Get File Information
num = regexp(fileNamePack, '\d+', 'match');
RecordDateOriginal=cell2mat(num(1));
RecordDate=datetime(RecordDateOriginal,'InputFormat','MMddyy');
FileNum=cell2mat(num (2));
%To get the monkey name
RemainFiles=erase(fileNamePack,RecordDateOriginal);
Delimiter=find(isstrprop(RemainFiles,'upper')==1);
MonkeyName=RemainFiles(Delimiter(1):Delimiter(2)-1);





if SamplingRate>1
    disp('Warning: Eye Sampling rate below 1000Hz!Alignment may be inacurate!Please check and use the relative time database')
end

if  strcmp(MonkeyName,'Robin')

    if RecordDate<datestr('03,01,2020')
        X_Bias(1:2)=5.38549;
        X_Gain(1:2)=1.15000;
        Y_Bias(1:2)=0.56108;
        Y_Gain(1:2)=1.30000;
    elseif RecordDate<datestr('03,02,2020')
        X_Bias(1:2)=-14.14279;
        X_Gain(1:2)=1.45;
        Y_Bias(1:2)=6.21775;
        Y_Gain(1:2)=1.30000;
    elseif RecordDate<datestr('03,09,2020')
        X_Bias(1:2)=-15.02194;
        X_Gain(1:2)=1.5;
        Y_Bias(1:2)=6.01092;
        Y_Gain(1:2)=1.35000;
    elseif  RecordDate<datestr('03,16,2020')
        
        X_Bias(1:2)=-18.02303;
        X_Gain(1:2)=1.5;
        Y_Bias(1:2)=5.40699;
        Y_Gain(1:2)=1.35000;
        
        
    elseif  RecordDate<datestr('07,07,2020')
        X_Bias(1:2)=-15.99500;
        X_Gain(1:2)=1.5;
        Y_Bias(1:2)=5.36039;
        Y_Gain(1:2)=1.35000;
        
    elseif  RecordDate<datestr('07,09,2020')
        
        X_Bias(1:2)=-15.98900;
        X_Gain(1:2)=1.5;
        Y_Bias(1:2)=6.76696;
        Y_Gain(1:2)=1.35000;
    elseif  RecordDate<datestr('07,23,2020')
        
        X_Bias(1:2)=-14.66866;
        X_Gain(1:2)=1.5;
        Y_Bias(1:2)=7.39926;
        Y_Gain(1:2)=1.35000;
        
    elseif  RecordDate<datestr('08,08,2020')
        X_Bias(1:2)=-15.99500;
        X_Gain(1:2)=1.5;
        Y_Bias(1:2)=7.10061;
        Y_Gain(1:2)=1.35000;
    elseif  RecordDate<datestr('08,11,2020')
        X_Bias(1:2)=-15.17117;
        X_Gain(1:2)=1.5;
        Y_Bias(1:2)=7.01289;
        Y_Gain(1:2)=1.35000;
    elseif  RecordDate<datestr('08,16,2020')
        X_Bias(1:2)=-15.93083;
        X_Gain(1:2)=1.5;
        Y_Bias(1:2)=6.43071;
        Y_Gain(1:2)=1.35000;
    elseif  RecordDate<datestr('08,18,2020')
        X_Bias(1:2)=-16.31031;
        X_Gain(1:2)=1.5;
        Y_Bias(1:2)=9.85658;
        Y_Gain(1:2)=1.35000;
    elseif  RecordDate<datestr('09,1,2020')
        X_Bias(1:2)=-15.94303;
        X_Gain(1:2)=1.5;
        Y_Bias(1:2)=9.25387;
        Y_Gain(1:2)=1.35000;
    elseif  RecordDate<datestr('10,28,2020')
        X_Bias(1)=-15.94303;
        X_Gain(1)=1.5;
        Y_Bias(1)=9.25387;
        Y_Gain(1)=1.35000;
    
        
        X_Bias(2)=0;
        X_Gain(2)=1;
        Y_Bias(2)=0;
        Y_Gain(2)=1;
    else
        %Start to use eyelink for both monkeys
         X_Bias(1:2)=0;
         X_Gain(1:2)=1;
         Y_Bias(1:2)=0;
         Y_Gain(1:2)=1; 
        
    end
elseif  strcmp(MonkeyName,'Adams')

    X_Bias(1:2)=0;
    X_Gain(1:2)=1;
    Y_Bias(1:2)=0;
    Y_Gain(1:2)=1; 
    
end
%end


EyeData(:,1)=cellfun(@(x) ((x/1000)+X_Bias(1))*X_Gain(1),EyeDataRaw(:,1),'UniformOutput', false);%From mV to V;Then from V to degree
EyeData(:,2)=cellfun(@(x) ((x/1000)+Y_Bias(1))*Y_Gain(1),EyeDataRaw(:,2),'UniformOutput', false);%From mV to V;Then from V to degree
EyeData(:,3)=cellfun(@(x) ((x/1000)+X_Bias(2))*X_Gain(2),EyeDataRaw(:,3),'UniformOutput', false);%From mV to V;Then from V to degree
EyeData(:,4)=cellfun(@(x) ((x/1000)+Y_Bias(2))*Y_Gain(2),EyeDataRaw(:,4),'UniformOutput', false);%From mV to V;Then from V to degree

if size(EyeDataRaw,2)>4
    OthersData=EyeDataRaw(:,5:end);
else
    OthersData=cell(size(EyeDataRaw,1),1);
end


EyeCalInfo=[X_Gain',X_Bias',Y_Gain',Y_Bias';
           ];%First row, left eye; second row:right eye

%Assign NaN to overscreen range eyetrace
ScreenRange=40;
EyeData(:,1:2)=cellfun(@FillInBlink,EyeData(:,1:2),'Uniform',0);




%Find out the total trials and the good trials(correct trials);
TotalTrials=size(EyeData,1);
LastThreeCode =cell2mat(cellfun(@(x) x(:,end-2:end), EventCodeForAll, 'UniformOutput', false));

%LastFourCode =cell2mat(cellfun(@(x) x(:,end-4:end), EventCodeForAll, 'UniformOutput', false));


GoodTrialsFinder=cellfun(@(x) sum(ismember(x,[CORRECTCD,ERROR])), EventCodeForAll)==1; %Now search for good trials among the whole dataset


%GoodTrialsFinder=(sum(LastThreeCode==CORRECTCD,2))>0; %Now search for good trials among the whole dataset
GoodTrialsIndex=find(GoodTrialsFinder==1);
NumberOfGoodTrials=sum(GoodTrialsFinder);

%Find out the last event marker(task end);
%TaskEnd=cell2mat(cellfun(@(x) x(:,end), EventTimeForAll, 'UniformOutput', false));
%Define CORRECT/ERROR marker as task end

TaskEndtmp=cellfun(@(x,y) y(find((x==CORRECTCD|x==ERR_BEEP|x==ERROR)==1,1,'last')), EventCodeForAll,EventTimeForAll, 'UniformOutput', false);
TaskEndtmpMat=cellfun(@(x) [x,NaN*ones(1,1-numel(x))],TaskEndtmp,'uniform',0);
TaskEnd=cell2mat(TaskEndtmpMat);

%Fill in NaN for the last marker
NaNEnd=isnan(TaskEnd);
if sum(NaNEnd)>0
    disp('No trial end was found in this trial');
    
    TaskEndNull=cellfun(@(x,y) y(find(x>0,1,'last')),EventCodeForAll(NaNEnd),EventTimeForAll(NaNEnd));
    TaskEnd(NaNEnd)=TaskEndNull;
end

%After 02142020, there might be bonus trials inside the main trial, first
%screen them out
BonusTrialMarker=[BONUSTRIALSTART,BONUSTRIALEND];
BonusTrialIndex=cell2mat(cellfun(@(x) ismember(BonusTrialMarker,x), EventCodeForAll, 'UniformOutput', false));
BonusTrialPointer=sum(BonusTrialIndex,2)>0;
BonusTrialIndicator=find(BonusTrialPointer>0);
NumberOfBonusTrials=sum(sum(BonusTrialIndex,2)>0);
NormalTrialIndex=find(~BonusTrialPointer>0);


%FirstThreeCode =cell2mat(cellfun(@(x) x(:,1:5), EventCodeForAll, 'UniformOutput', false));

%Screan out the pre-task eye trace
TaskEndInBin=ceil(TaskEnd-EyeStartRecordTime)*SamplingRate;
%TrialEndInBin=ceil(EyeStopRecordTime-EyeStartRecordTime)*SamplingRate;
TrialEndInBin=cellfun(@numel,EyeData(:,1));

tmp=SelectEyeInterval(EyeData(:,1),TaskEndInBin,TrialEndInBin);
EyeDataPre(:,1)={NaN,tmp{1}{1:end-1}};

tmp=SelectEyeInterval(EyeData(:,2),TaskEndInBin,TrialEndInBin);
EyeDataPre(:,2)={NaN,tmp{1}{1:end-1}};

tmp=SelectEyeInterval(EyeData(:,3),TaskEndInBin,TrialEndInBin);
EyeDataPre(:,3)={NaN,tmp{1}{1:end-1}};

tmp=SelectEyeInterval(EyeData(:,4),TaskEndInBin,TrialEndInBin);
EyeDataPre(:,4)={NaN,tmp{1}{1:end-1}};





%Set up a container for the task related parameters
ParaLibHeader=unique(Raw.UserData(:,3)); 
for i=1:length(ParaLibHeader)
    
    Index=strcmp(Raw.UserData(:,3), ParaLibHeader{i});
    HeaderSet{i}=ParaLibHeader{i}(2:end);
    ParaLib_All{i}=cell2mat(Raw.UserData(Index,1));
    SelectForGoodTrials=ismember(ParaLib_All{i}(:,1),GoodTrialsIndex);
    ParaLib_Good{i}=ParaLib_All{i}(SelectForGoodTrials,:);
   
    
end
ParaLib_Whole=containers.Map(HeaderSet,ParaLib_All);
ParaLib_OnlyGood=containers.Map(HeaderSet,ParaLib_Good);



TrialType=NaN*ones(sum(NormalTrialIndex),1);%For stroring data for all trials;

%Sort the data according the behavior outcome;
%if(ismember('BehaviorOutCome',keys(ParaLib_Whole)))
try
    BehaviorOutcome=ParaLib_Whole('BehaviorOutCome');
  
   TrialType=BehaviorOutcome(NormalTrialIndex,2);
    %This good trial index is retreived from those who has behavioroutcome;
    %so the dataset didn't include the bonus trials;
    %If the task didn't contain the bonus trials, this good trial finder
    %should be exactly the same as the above good trial finder
  % GoodTrialsFinder_Normal=BehaviorOutcome(:,2)==CORRECTCD ;
  % GoodTrialsIndex_Normal=BehaviorOutcome(BehaviorOutcome(:,2)==CORRECTCD,:);
  %GoodTrialsIndex_Normal=GoodTrialsIndex_Normal(:,1);
   
  GoodTrialsFinder_Normal=GoodTrialsFinder;
    GoodTrialsIndex_Normal=GoodTrialsIndex;
    

   BreakTrialsFinder=BehaviorOutcome(:,2)==BROKEFIX;
   BreakTrialsIndex=BehaviorOutcome(BehaviorOutcome(:,2)==BROKEFIX,:);
   BreakTrialsIndex=BreakTrialsIndex(:,1);
   NumberOfBreakTrials=length(BreakTrialsIndex);

   NoFixTrialsFinder=BehaviorOutcome(:,2)==NOFIX;
   NoFixTrialsIndex=BehaviorOutcome(BehaviorOutcome(:,2)==NOFIX,:);
   NoFixTrialsIndex=NoFixTrialsIndex(:,1);
   NumberOfNoFixTrials=length(NoFixTrialsIndex);

   FailSacTrialsFinder=BehaviorOutcome(:,2)==FAILED_SAC;
   FailSacTrialsIndex=BehaviorOutcome(BehaviorOutcome(:,2)==FAILED_SAC ,:);
   FailSacTrialsIndex=FailSacTrialsIndex(:,1);
   NumberOfFailSacTrials=length(FailSacTrialsIndex);
 
   OtherTrialsFinder=~(GoodTrialsFinder_Normal|BreakTrialsFinder|NoFixTrialsFinder|FailSacTrialsFinder);
   OtherTrialsIndex=find(OtherTrialsFinder==1);
   
   TotalTrials_Normal=size(BehaviorOutcome,1);
   NumberOfOtherFailTrials=TotalTrials_Normal-NumberOfGoodTrials-NumberOfBreakTrials-NumberOfNoFixTrials-NumberOfFailSacTrials;

 
    
  
%else
catch
    disp("There is no user log in the file, rescue trial information with event marker!");
    GoodTrialsFinder_Normal=GoodTrialsFinder;
    GoodTrialsIndex_Normal=GoodTrialsIndex;
    
    TrialType(GoodTrialsIndex)=CORRECTCD;
    
    BreakTrialsFinder=(sum(LastThreeCode==BROKEFIX,2))>0; %Now search for good trials among the whole dataset
    BreakTrialsIndex=find(BreakTrialsFinder==1);
    NumberOfBreakTrials=sum(BreakTrialsFinder);
    
    TrialType(BreakTrialsIndex)=BROKEFIX;
    
   NoFixTrialsFinder=(sum(LastThreeCode==NOFIX,2))>0;
   NoFixTrialsIndex=find(NoFixTrialsFinder==1);
   NoFixTrialsIndex=NoFixTrialsIndex(:,1);
   NumberOfNoFixTrials=length(NoFixTrialsIndex);
   
   TrialType(NoFixTrialsIndex)=NOFIX;
   
   FailSacTrialsFinder=(sum(LastThreeCode==FAILED_SAC,2))>0;
   FailSacTrialsIndex=find(FailSacTrialsFinder==1);
   FailSacTrialsIndex=FailSacTrialsIndex(:,1);
   NumberOfFailSacTrials=length(FailSacTrialsIndex);
   
   TrialType(FailSacTrialsIndex)=FAILED_SAC;
   
   OtherTrialsFinder=~(GoodTrialsFinder_Normal|BreakTrialsFinder|NoFixTrialsFinder|FailSacTrialsFinder);
   OtherTrialsIndex=find(OtherTrialsFinder==1);
   
   
   
   TotalTrials_Normal=size(LastThreeCode,1);
   NumberOfOtherFailTrials=TotalTrials_Normal-NumberOfGoodTrials-NumberOfBreakTrials-NumberOfNoFixTrials-NumberOfFailSacTrials;

  
end

  BehaviorHeader={'TotalTrialNum','CorrectTrialNum','BreakTrialNum','NoFixTrialNum','FailSacTrialNum','OthersNum','GoodTrialsFinder',...
    'BreakTrialsFinder','NoFixTrialsFinder','FailSacTrialsFinder','OtherTrialsFinder','GoodTrialsIndex'...
    'BreakTrialsIndex','NoFixTrialsIndex','FailSacTrialsIndex','OtherTrialsIndex','BonusTrialNum'};
   BehaviorPerformance={TotalTrials,NumberOfGoodTrials,NumberOfBreakTrials,NumberOfNoFixTrials,NumberOfFailSacTrials,NumberOfOtherFailTrials...
   GoodTrialsFinder_Normal,BreakTrialsFinder,NoFixTrialsFinder,FailSacTrialsFinder,OtherTrialsFinder,GoodTrialsIndex_Normal,BreakTrialsIndex,NoFixTrialsIndex,FailSacTrialsIndex,OtherTrialsIndex,NumberOfBonusTrials};

BehaviorSummary=containers.Map(BehaviorHeader,BehaviorPerformance);





ValidUserLog=(ismember('FixPointID,Loc_X,Loc_Y', keys(ParaLib_Whole))&...
    ismember('RewardAmount', keys(ParaLib_Whole)))||(ismember('TargetID,Size,Loc_X,Loc_Y', keys(ParaLib_Whole)));

%Change it into reward amount for consistency of scene free view task
  %  ismember('TargetID,Size,Loc_X,Loc_Y', keys(ParaLib_Whole));


%Next, to find out the basic task related parameters
%Fixation Point and Location for all trials

FixationPointIndex=[[1:TotalTrials]',NaN*ones(TotalTrials,1)];


FixLoc=FixationPointIndex;
TargetIndex=FixationPointIndex;
TargetSize=FixationPointIndex;
TargetLoc=FixationPointIndex;
RewardAmount=FixationPointIndex;
TargetNum=FixationPointIndex;
SceneIndex=FixationPointIndex;
SceneLoc=FixationPointIndex;
TargetPolarLoc=FixationPointIndex;
GoodObjectLib=FixationPointIndex;
BadObjectLib=FixationPointIndex;
SceneLib=FixationPointIndex;
ChoiceOutcome=FixationPointIndex;
BlockType_Whole=[[1:TotalTrials]',NaN*ones(TotalTrials,2)];

%TrialIndexBlip=[];
FixationPointIndexBonus=[];
FixLocBonus=[];
SceneIndexBonus=[];
SceneLocBonus=[];
BonusTrialCondition=[];

TargetLocBonus=[];
TargetIndexBonus=[];
TargetPolarLocBonus=[];
TargetSizeBonus=[];

if ValidUserLog
 
%Fixation Point;

        if ismember('FixPointID,Loc_X,Loc_Y',keys(ParaLib_Whole))
         FixationPointInform=ParaLib_Whole('FixPointID,Loc_X,Loc_Y');
         FixationPointIndex=FixationPointInform(:,1:2);
         FixLoc=FixationPointInform(:,[1,3,4]);
         
        end
         %After 02172020, the bonus trial string indicator will be totally
         %separated from the normal trial indicator
          if ismember('FixPointIDBonus,Loc_X,Loc_Y', keys(ParaLib_Whole))
               FixationPointInformBonus=ParaLib_Whole('FixPointIDBonus,Loc_X,Loc_Y');
               FixationPointIndexBonus=FixationPointInformBonus(:,1:2);
               FixLocBonus=FixationPointInformBonus(:,[1,3,4]);
          elseif NumberOfBonusTrials>0
                FixationPointIndexBonus=FixationPointIndex(ismember(FixationPointIndex(:,1),BonusTrialIndicator),1:2); 
                FixLocBonus=FixLoc(ismember(FixationPointIndex(:,1),BonusTrialIndicator),1:2); 
 
          end
         
         
         
  
%Scene information;

        if ismember('SceneID,SceneLocX,SceneLocY', keys(ParaLib_Whole))
        
             SceneInformation=ParaLib_Whole('SceneID,SceneLocX,SceneLocY');
             SceneIndex=SceneInformation(:,1:2);  
             SceneLoc= SceneInformation(:,[1,3,4]);
           
           
            if ismember('SceneID,SceneRealName', keys(ParaLib_Whole))
             SceneIndex=ParaLib_Whole('SceneID,SceneRealName');
            
             ImageAssociationIndex=1;%To indicate that the scene index and the realname has been associated
   
            end
             
             
             
             
         % After 02172020, the bonus trial string indicator will be totally
         %separated from the normal trial indicator
          if ismember('SceneIDBonus,SceneLocX,SceneLocY', keys(ParaLib_Whole))
             SceneInformationBonus=ParaLib_Whole('SceneIDBonus,SceneLocX,SceneLocY');
             SceneIndexBonus=SceneInformationBonus(:,1:2);  
             SceneLocBonus= SceneInformationBonus(:,[1,3,4]);
             
             
             if ismember('SceneIDBonus,SceneRealName', keys(ParaLib_Whole))
                 SceneIndexBonus=ParaLib_Whole('SceneIDBonus,SceneRealName');
             end
             
          elseif  NumberOfBonusTrials>0
              
             SceneIndexBonus=SceneIndex(ismember(SceneIndex(:,1),BonusTrialIndicator),:);  
             SceneLocBonus= SceneLoc(ismember(SceneLoc(:,1),BonusTrialIndicator),:);
              
         
          end
         
             
             
             
             
        else
     disp("This is not a scene related task!")

        end
%Target information;

if ismember('TargetID,Size,Loc_X,Loc_Y', keys(ParaLib_Whole))
    
         TargetInformation=ParaLib_Whole('TargetID,Size,Loc_X,Loc_Y');
         TargetIndex=TargetInformation(:,1:2);
         TargetSize=TargetInformation(:,[1,3]);
         TargetLoc=TargetInformation(:,[1,4,5]);
         if ismember('TotalTargetNumber', keys(ParaLib_Whole))
             TargetNum=ParaLib_Whole('TotalTargetNumber');
         end
             
         
          if ismember('TargetID,TargetRealName', keys(ParaLib_Whole))
             TargetIndex=ParaLib_Whole('TargetID,TargetRealName');
           
          end
     
         if ismember('TargetID,Size,Angle,Eccentricity', keys(ParaLib_Whole))
             TargetPolarLoc=ParaLib_Whole('TargetID,Size,Angle,Eccentricity');
             TargetPolarLoc=TargetPolarLoc(:,[1,4,5]);
  
         else
             TargetAngle=atan2d(TargetLoc(:,3),TargetLoc(:,2));%Transform into angle in degree
             TargetAngle= TargetAngle+90+180;
             if sum(TargetAngle>=360)
                 TargetAngle(TargetAngle>=360)=TargetAngle(TargetAngle>=360)-360;
             end
            
             TargetEcc=sqrt(TargetLoc(:,2).^2+TargetLoc(:,3).^2);
             TargetPolarLoc=[TargetLoc(:,1),TargetAngle,TargetEcc];
         end
         
         
          %Bonus trial
           if ismember('BonusTrialCondition', keys(ParaLib_Whole))
               BonusTrialCondition=ParaLib_Whole('BonusTrialCondition');
               
           end
          
          
         if ismember('TargetID1,Size,Loc_X,Loc_Y', keys(ParaLib_Whole))
             TargetInformationBonus1=ParaLib_Whole('TargetID1,Size,Loc_X,Loc_Y');
          %   TargetIndexBonus1=TargetInformationBonus1(:,1:2);  
             TargetSizeBonus1=TargetInformationBonus1(:,[1,3]);
             TargetLocBonus1=TargetInformationBonus1(:,[1,4,5]);
             
            TargetIndexBonus1=ParaLib_Whole('TargetID1,TargetRealName1');     
            
       
         end
          if ismember('TargetID2,Size,Loc_X,Loc_Y', keys(ParaLib_Whole))
             TargetInformationBonus2=ParaLib_Whole('TargetID2,Size,Loc_X,Loc_Y');
            % TargetIndexBonus2=TargetInformationBonus2(:,1:2);  
             TargetSizeBonus2=TargetInformationBonus2(:,[1,3]);
             TargetLocBonus2=TargetInformationBonus2(:,[1,4,5]);
            
             TargetIndexBonus2=ParaLib_Whole('TargetID2,TargetRealName2');  
             
             TargetIndexBonus=[TargetIndexBonus1,TargetIndexBonus2(:,2:end)];
             TargetLocBonus=[TargetLocBonus1,TargetLocBonus2(:,2:end)];
             TargetSizeBonus=[TargetSizeBonus1,TargetSizeBonus2(:,2:end)];
             
             
             TargetAngleBonus=atan2d(TargetLocBonus(:,3),TargetLocBonus(:,2));%Transform into angle in degree
             TargetAngleBonus= TargetAngleBonus+90+180;
             if sum(TargetAngleBonus>=360)
                 TargetAngleBonus(TargetAngleBonus>=360)=TargetAngleBonus(TargetAngleBonus>=360)-360;
             end
             TargetAngleBonus2=TargetAngleBonus+180;
             TargetAngleBonus2(TargetAngleBonus2>=360)=TargetAngleBonus2(TargetAngleBonus2>=360)-360;
             TargetEccBonus=sqrt(TargetLocBonus(:,2).^2+TargetLocBonus(:,3).^2);
             TargetPolarLocBonus=[TargetLocBonus(:,1),TargetAngleBonus,TargetEccBonus,TargetAngleBonus2,TargetEccBonus];
             
  
         end
         
else
     disp("This is not a target related task!")
         
end         
         
        % if TaskCode==FORAGING_TASK || TaskCode==FORAGING_TASK_SEQ ||TaskCode==FORAGING_TASK_LOCSEQ 
         if ismember('SceneIDLib,SceneName',keys(ParaLib_Whole))  
       
           
             SceneLib=ParaLib_Whole('SceneIDLib,SceneName');
              %After 02142020, I don't need the predefined library anymore, but leave it here for backward compacity 
            if ismember('GoodObjectIDLib,GoodObjectName',keys(ParaLib_Whole))
                 GoodObjectLib=ParaLib_Whole('GoodObjectIDLib,GoodObjectName');
            else
                GoodObjectLib=SceneLib;
                GoodObjectLib(:,2:end)=NaN*GoodObjectLib(:,2:end);
            end
            if ismember('BadObjectIDLib,BadObjectName',keys(ParaLib_Whole))
                 BadObjectLib=ParaLib_Whole('BadObjectIDLib,BadObjectName');
                
            else
                 BadObjectLib=SceneLib;
                BadObjectLib(:,2:end)=NaN*BadObjectLib(:,2:end);
                
            end
            
            

           
            SceneAndObjectLib=[SceneLib,GoodObjectLib(:,2:end),BadObjectLib(:,2:end)];
            if ~ImageAssociationIndex
               if SceneAndObjectLib(1,1)~=SceneIndex(1,1) %If the trial is not start from zero, try to rescue the scene type with the default scene type
                %This is only for one file: Robin010820FORAG1.rst; It will
                %no longer happen after 02152020
                LostTrials=1:SceneAndObjectLib(1,1)-1;
                SceneIndexLost_unique=unique(SceneIndex(LostTrials,2));
                
                if min(SceneIndexLost_unique)==21
                    %This is old files and event codes
                    disp('First_SceneStartFrom 21');
                 ECode_Old;
                    
                end
                
                
                %Use the default scene set information to rescue the scene
                %name
                disp('Rescue scene object library with default scene object sets')
                UniqueTargetIndex=unique(TargetIndex(ismember(TargetIndex(:,1),LostTrials),2));
                GoodFractalIndex=UniqueTargetIndex(mod(UniqueTargetIndex,2)==1);
                BadFractalIndex=UniqueTargetIndex(mod(UniqueTargetIndex,2)==0);
                
                if TaskCode==FORAGING_TASK
                    if length(SceneIndexLost_unique)==6 %Scene set A/Scene set B
                        defaultScene=[[FIRST_SCENE:TWELVETH_SCENE]',[1040:1047,1050:1053]'];
                        defaultFractalGood=[[FIRSTGOOD:2:TWELVETHGOOD]',[1580:1583,1590:1593,1600:1603]'];
                        defaultFractalBad=[[FIRSTBAD:2:TWELVETHBAD]',[1584:1587,1594:1597,1604:1607]'];  
                      %  defaultFractalGood=[GoodFractalIndex,[1580:1583,1590:1593,1600:1603]'];
                      %  defaultFractalBad=[BadFractalIndex,[1584:1587,1594:1597,1604:1607]'];  
                        
                        
                        
                        SceneLostLoc=ismember(defaultScene,SceneIndexLost_unique);
                        SceneLost=defaultScene(SceneLostLoc,:);
                        GoodFractalLost=defaultFractalGood(SceneLostLoc,:);
                        BadFractalLost=defaultFractalBad(SceneLostLoc,:);
                        SceneAndObjectLibRescue=[ones(length(SceneLost(:,1)),1),SceneLost,GoodFractalLost,BadFractalLost];
                    else
                      defaultScene=[[FIRST_SCENE:TWELVETH_SCENE]',[1000:1007,1010:1013]'];
                      %defaultFractalGood=[GoodFractalIndex,[1500:1503,1510:1513,1520:1523]'];
                      %defaultFractalBad=[BadFractalIndex,[1504:1507,1514:1517,1524:1527]'];
                      
                        defaultFractalGood=[[FIRSTGOOD:2:TWELVETHGOOD]',[1500:1503,1510:1513,1520:1523]'];
                        defaultFractalBad=[[FIRSTBAD:2:TWELVETHBAD]',[1504:1507,1514:1517,1524:1527]'];   
                        SceneLostLoc=ismember(defaultScene,SceneIndexLost_unique);
                        SceneLost=defaultScene(SceneLostLoc,:);
                        GoodFractalLost=defaultFractalGood(SceneLostLoc,:);
                        BadFractalLost=defaultFractalBad(SceneLostLoc,:);
                        SceneAndObjectLibRescue=[ones(length(SceneLost(:,1)),1),SceneLost,GoodFractalLost,BadFractalLost];  
                        
                       
                    end
                end
                SceneAndObjectLib=[SceneAndObjectLibRescue;SceneAndObjectLib];
                
               end
            end
            
            
        
            
          

         end
         
   %Block type      
         if ismember('CurrentBlockMode,CurrentSceneSet',keys(ParaLib_Whole))
             BlockType_Whole=ParaLib_Whole('CurrentBlockMode,CurrentSceneSet');
             if BlockType_Whole(1,1)~=SceneIndex(1,1) %If the trial is not start from zero, try to rescue the block type information from fixation point
                 TheoreticalTrials=SceneIndex(:,1);
                 LostTrials=TheoreticalTrials(~ismember(TheoreticalTrials, BlockType_Whole(:,1)));
                 BlockType_Whole=BlockInformRescue(BlockType_Whole,LostTrials,FixationPointIndex,SceneAndObjectLib);
             end
         elseif TaskCode==FORAGING_TASK ||TaskCode==FORAGING_TASK_SEQ ||TaskCode==FORAGING_TASK_LOCSEQ
             %Rescue block type
             FixedSeqATrials=FixationPointIndex(FixationPointIndex(:,2)==FIXFRA,1);
             FixedSeqBTrials=FixationPointIndex(FixationPointIndex(:,2)==FIXFRB,1);
             RandomSeqTrials=FixationPointIndex(~ismember(FixationPointIndex(:,2),[FIXFRB,FIXFRA]),1);
             if TaskCode~=FORAGING_TASK_LOCSEQ
                 RandomSeqATrials=SceneIndex((SceneIndex(:,2)<= SIXTH_SCENE ),1);
                 RandomSeqBTrials=SceneIndex((SceneIndex(:,2)> SIXTH_SCENE ),1);
             else
                 RandomSeqATrials=RandomSeqTrials;
                 RandomSeqBTrials=0;
             end
             
             % BlockType_Whole(BlockType_Whole(:,1),FixationPointIndex(FixationPointIndex(:,2)==FIXFRA,:)))=[0,0];
             %  BlockType_Whole(:,1)=SceneIndex(:,1);
             BlockType_Whole(ismember(BlockType_Whole(:,1),FixedSeqATrials),2:3)=repmat([0,0],sum(ismember(BlockType_Whole(:,1),FixedSeqATrials)),1);
             BlockType_Whole(ismember(BlockType_Whole(:,1),FixedSeqBTrials),2:3)=repmat([0,1],sum(ismember(BlockType_Whole(:,1),FixedSeqBTrials)),1);
             BlockType_Whole(ismember(BlockType_Whole(:,1),RandomSeqATrials),2:3)=repmat([1,0],sum(ismember(BlockType_Whole(:,1),RandomSeqATrials)),1);
             BlockType_Whole(ismember(BlockType_Whole(:,1),RandomSeqBTrials),2:3)=repmat([1,1],sum(ismember(BlockType_Whole(:,1),RandomSeqBTrials)),1);
         else
             disp('No special block type');
         end
 


%ChoiceOutCome
         if ismember('ChoiceOutCome', keys(ParaLib_Whole))
       
                  ChoiceOutcome=ParaLib_Whole('ChoiceOutCome');
 
         else
                disp("This is not a choice task!")

        
         end
 


%Reward amount
         if ismember('RewardAmount',keys(ParaLib_Whole))
             RewardAmount=ParaLib_Whole('RewardAmount');
         else
             RewardAmount =[[1:TotalTrials]',NaN*ones(TotalTrials,1)];
             
             
         end
             
             
        
         
 

else
     disp("There is no user log defining information in the file, rescue trial from what we have!");
     ECode_Old;
     if ismember('ID,Switched?,OnOff?,X,Y',keys(ParaLib_Whole))
         temp_Whole=ParaLib_Whole('ID,Switched?,OnOff?,X,Y');
         %Retrive scene information
         SceneWhole=temp_Whole(((temp_Whole(:,2)>=FIRST_SCENE & temp_Whole(:,2)<=TWELVETH_SCENE)&(temp_Whole(:,4)>0)),:);
         SceneIndex=SceneWhole(:,1:2);
         
         
         %Retrive target information;
        % TargetWhole=temp_Whole(((temp_Whole(:,2)>=FIRSTBAD & temp_Whole(:,2)<=TWELVETHGOOD+1)&(temp_Whole(:,4)>0)),:);
         TargetWhole=temp_Whole(((temp_Whole(:,2)>=FIRSTGOOD & temp_Whole(:,2)<=TWELVETHBAD	)&(temp_Whole(:,4)>0)),:);
         TargetIndex=TargetWhole(:,[1,2]);
         TargetSize=[TargetIndex(:,1),10*ones(length(TargetIndex(:,1)),1)];
         disp('Fix target size to 10 deg');
         TargetLoc=TargetWhole(:,[1,end-1:end]);
         Polar_Temp=LocToAngle(TargetLoc(:,2),TargetLoc(:,3));
         TargetPolarLoc=[TargetLoc(:,1),Polar_Temp];
         
         TargetCount = countmember(unique(TargetIndex(:,1)),TargetIndex(:,1));
         TargetNum= [unique(TargetIndex(:,1)), TargetCount];
         
     end
     AllTags=keys(ParaLib_Whole);
     for i=1:length(AllTags)
         
         NumOfUniqueScene=12;
         
         if contains(AllTags{i},'SceneID')
          SceneLib=ParaLib_Whole(AllTags{i});
          if size(SceneLib(:,2:end),2)<NumOfUniqueScene
              
              LastScene=max(SceneLib(:,2:end),[],2);
              ContinueScene=LastScene+1;
              for j=1:NumOfUniqueScene-size(SceneLib(:,2:end),2)-1
                  
                  ContinueScene=[ContinueScene,LastScene+j+1];
                  
              end
              
              SceneLib=[SceneLib,ContinueScene];
              
          end
          
          
         end
         if contains(AllTags{i},'GoodObjectIndex')
           GoodObjectLib=ParaLib_Whole(AllTags{i});
            if size(GoodObjectLib(:,2:end),2)<NumOfUniqueScene
              
              LastGoodObj=max(GoodObjectLib(:,2:end),[],2);
              ContinueGoodObj=LastGoodObj+1;
              for j=1:NumOfUniqueScene-size(GoodObjectLib,2)
                  
                  ContinueGoodObj=[ContinueGoodObj,LastGoodObj+j+1];
                  
             end
              
             GoodObjectLib=[GoodObjectLib,ContinueGoodObj];
               
           end
          
           
           
           
         end
         if contains(AllTags{i},'BadObjectIndex')           
          BadObjectLib=ParaLib_Whole(AllTags{i});   
          
          if size(BadObjectLib(:,2:end),2)<NumOfUniqueScene
              
              LastBadObj=max(BadObjectLib(:,2:end),[],2);
              ContinueBadObj=LastBadObj+1;
              for j=1:NumOfUniqueScene-size(BadObjectLib,2)
                  
                  ContinueBadObj=[ContinueBadObj,LastBadObj+j+1];
                  
             end
              
             BadObjectLib=[BadObjectLib,ContinueBadObj];
          
   
          end
 
         end
     end
     SceneAndObjectLib=[];
     for j=1:length(SceneLib(:,1))
         SceneAndObjectLib=[SceneAndObjectLib;[SceneLib(j,1)*ones(size(SceneLib(j,2:end)')),[FIRST_SCENE:TWELVETH_SCENE]',SceneLib(j,2:end)',[FIRSTGOOD:2:TWELVETHGOOD]',GoodObjectLib(j,2:end)',[FIRSTBAD:2:TWELVETHBAD]',BadObjectLib(j,2:end)']];
   
     end
     
      SceneLib= SceneAndObjectLib(:,[1:3]);
      GoodObjectLib=SceneAndObjectLib(:,[1,4,5]);
      BadObjectLib=SceneAndObjectLib(:,[1,6,7]);
     
    
end
 


  
%Find out the "analogue bin"(e.g. eyechannel) corresponding to each event marker according to the event time;
TimeLimitsForOneTrial=1*60*10^3;%the maximum collecting time for one trial(2 minutes), in ms, to prevent out of memory.
MaximumBinNum=ceil(TimeLimitsForOneTrial*SamplingRate);
EyeSelectionWidth=min(max(cellfun(@numel,EyeData(:,1))),MaximumBinNum);




EyeChannel_X_L=NaN*ones(TotalTrials,EyeSelectionWidth);%Use a maximum matrix to store all the data
EyeChannel_Y_L=EyeChannel_X_L;
EyeChannel_X_R=EyeChannel_X_L;
EyeChannel_Y_R=EyeChannel_X_L;
EyeTimeChannel=EyeChannel_X_L;

EventDataChannel=NaN*ones(TotalTrials,max(cellfun(@numel,EventCodeForAll)));%Use a maximum matrix to store all the data
EventBinChannel=EventDataChannel;
EventTimeChannel=EventDataChannel;



%TargetIndex=[TargetIndex,TargetIndex(:,2)];
%SceneIndex=[SceneIndex,SceneIndex(:,2)];


TruncatedIndex=0;%Record the number of truncated trials;
TruncatedTrials=[];%Record the truncated trials;

 %Too slow, don't need it any more
 %{
 %Reorganize the eyedata and event data into a matrix
 
 EyeChannel_X_L=EyeData(:,1);
 EyeChannel_Y_L=EyeData(:,2);
 EyeChannel_X_R=EyeData(:,3);
 EyeChannel_Y_R=EyeData(:,4);
 
 MaxNumOfLength=max(cellfun(@(x) numel(x),EyeChannel_X_L ));
 
 if MaxNumOfLength>MaximumBinNum
 
 TruncatedFinder=cellfun(@(x) numel(x)>MaximumBinNum,EyeChannel_X_L,'uniform',0 );
 TruncatedTrials=find(cell2mat(TruncatedFinder)==1);
 TruncatedIndex=sum(cell2mat(TruncatedFinder));
 MaxNumOfLength=MaximumBinNum;
 end
     

 EyeChannel_X_L=cellfun(@(x) [x,NaN*ones(1,MaxNumOfLength-numel(x))],EyeChannel_X_L,'uniform',0);
 EyeChannel_X_L=cell2mat(cellfun(@(x,y) x(1:MaxNumOfLength),EyeChannel_X_L,'uniform',0));
 
 EyeChannel_Y_L=cellfun(@(x) [x,NaN*ones(1,MaxNumOfLength-numel(x))],EyeChannel_Y_L,'uniform',0);
 EyeChannel_Y_L=cell2mat(cellfun(@(x,y) x(1:MaxNumOfLength),EyeChannel_Y_L,'uniform',0));
 
 
 
 
 EyeChannel_X_R=cellfun(@(x) [x,NaN*ones(1,MaxNumOfLength-numel(x))],EyeChannel_X_R,'uniform',0);
 EyeChannel_X_R=cell2mat(cellfun(@(x,y) x(1:MaxNumOfLength),EyeChannel_X_R,'uniform',0));
 
 EyeChannel_Y_R=cellfun(@(x) [x,NaN*ones(1,MaxNumOfLength-numel(x))],EyeChannel_Y_R,'uniform',0);
 EyeChannel_Y_R=cell2mat(cellfun(@(x,y) x(1:MaxNumOfLength),EyeChannel_Y_R,'uniform',0));
 
 
 
 EyeTimeChannel=cell2mat(arrayfun(@(x,y) linspace(x,y,MaxNumOfLength),EyeDataTime(:,1),EyeDataTime(:,1)+MaxNumOfLength/SamplingRate,'uniform',0))-EyeStartRecordTime;
%}
 
 %%%%%%%Load extra spike database from Plexon/V probe: 
%Setup output directory
Workingdirectory=pwd;
%Set up output path according to the system
OperationSystem = computer;%Get the operation system information

if strcmp(OperationSystem(1:3),"PCW")  
    %PC
     MarkerFolder='DataHub';
     SysDelimeter='\';
elseif strcmp(OperationSystem(1:3),"MAC")  
    %Mac
     MarkerFolder='DataAnalysis';
     SysDelimeter='/';
end
 

EventCodeType = 1;%1:Blip;2:Plexon;

Flag=strfind(Workingdirectory,MarkerFolder);
PlexonPath=strcat(Workingdirectory(1:Flag+length(MarkerFolder)),PlexonDataFolder,SysDelimeter,PlexonParsedDataFolder,SysDelimeter);
%Load the extra Spike Channel
SpikeTime_Extra=[];
SpikeWaveForm_Med=[];
%SpikeWaveFormTime_Extra=[];
LFP=NaN*ones(TotalTrials,1);
LFPValidIndex=0;
LFPTime_Pre=[];
LFPTime=NaN*ones(TotalTrials,1);
LFPSamplingRate=NaN;
PlexonStartingChannel=4;
%SpikeWaveFormSample=[];
PlexonFileName=[];
ClusterID=[1:size(SpikeTime,2)]';%Default value for single electrode
ChannelID=ones(length(ClusterID),1);%Default value for single electrode
ExtraSpikePath=[];
SpikeReOrderIndex=[];
ExtraSpikePath=strcat(PlexonPath,RecordDateOriginal,SysDelimeter);


if exist(ExtraSpikePath)
    
    PlexonFileName=strcat(MonkeyName,RecordDateOriginal,'N',num2str(FileNum),'T',num2str(TaskCode),'.mat');
    cd(ExtraSpikePath);
    if exist(PlexonFileName)
        
       load(PlexonFileName);
       %Measure the basic information
       TrialNum_Plexon=su_task.TrialNum;
       SpikeTime_Extra_Pre=su_task.SpikeTiming;       
       SpikeWaveForm_Med=su_task.MedWaveform;
       Event_Plexon=su_task.Event;
       EventTiming_Plexon=su_task.EventTiming;
       fillClustertmp=[ClusterID;NaN*ones(3-length(ClusterID),1)];
       fillChanneltmp=[ChannelID;NaN*ones(3-length(ChannelID),1)];
      
      
       TrialIndex_Plexon=su_task.TrialIndex;
       A=TrialIndex_Plexon;
       B=TrialIndexBlip;
       
       %Load lfp
       lfpName=strcat(PlexonFileName(1:end-4),'lfp');
       try
       load(lfpName);   
       LFP=lfp_task.LFP;
       LFPTime_Pre=lfp_task.LFPTime;
       LFPSamplingRate=lfp_task.LFPSamplingRate;
       catch
           disp('No LFP data found');
           LFP = NaN;
           LFPTime_Pre =NaN;
           LFPSamplingRate = NaN;
           
           
       end
      % SpikeWaveFormTime_Extra=su_task.WaveformTime;
      % SR=su_task.SpikeWaveFormSamplingRate;
      %
       %First check the correspondance of the trial number
       if TrialNum_Plexon==TotalTrials
           %Align Event Code
           
           try
           Plexon_StartMarker=PLX_ON;
           %Plexon_StartMarker=ON_STIM;
           
           AlignTimeBlip=cellfun(@(x,y) y(find(x==Plexon_StartMarker,1,'first')),EventCodeForAll,EventTimeForAll);%in ms
           AlignTimePlexon=cellfun(@(x,y) y(find(x==Plexon_StartMarker,1,'first'))*1000,Event_Plexon,EventTiming_Plexon);%transform s into ms
           catch
           
               disp('Align code switch to ENABLE');
                Plexon_StartMarker=ENABLECD;
                AlignTimeBlip=cellfun(@(x,y) y(find(x==Plexon_StartMarker,1,'first')),EventCodeForAll,EventTimeForAll);%in ms
                AlignTimePlexon=cellfun(@(x,y) y(find(x==Plexon_StartMarker,1,'first'))*1000,Event_Plexon,EventTiming_Plexon);%transform s into ms
               
           end
           
         
          
          %Change to the common time
         RefTimeDiff=AlignTimeBlip-AlignTimePlexon;
          Index=num2cell([1:TotalTrials]');
          
          SpikeTime_Extra=cellfun(@(x) cellfun(@(y,z) y'*1000+RefTimeDiff(z),x, Index,'uniform',0),SpikeTime_Extra_Pre,'uniform',0);%in ms
          %Reorder the spike time according to the recording channel number;
       %   ClusterID_ori=[fillClustertmp;cell2mat(su_task.clusterID)'];
       %  ChannelID_ori=[fillChanneltmp;cell2mat(su_task.channelID)'];
       
       
            ClusterID_ori=su_task.clusterID;
            ChannelID_ori=su_task.channelID;
     
        
       
       
         ClusterID=[fillClustertmp;ClusterID_ori];
         ChannelID=[fillChanneltmp;ChannelID_ori];
          if ~isnan(LFPSamplingRate)
            LFPTime=cellfun(@(x,y) x*1000+RefTimeDiff(y),LFPTime_Pre,Index,'uniform',0);
            LFPValidIndex=1;
          else
             LFPValidIndex=0;
          end
        
          %Event Marker Match Check
         EventTime_AfterAlign_Plexon=cellfun(@(x,y) x*1000+RefTimeDiff(y),EventTiming_Plexon,Index,'uniform',0);%in ms
         
         
        
          PlexonMatch=cellfun(@EventMatch, Event_Plexon,EventCodeForAll,'uniform',0);
          BlipMatch=cellfun(@EventMatch,EventCodeForAll,Event_Plexon,'uniform',0);
          
          
          %Event check
          PlexonEventCommon_Check=cellfun(@(x,y) y(logical(x))',PlexonMatch,Event_Plexon,'uniform',0);
          BlipEventCommon_Check=cellfun(@(x,y) y(logical(x))',BlipMatch,EventCodeForAll,'uniform',0);
          
          
          PlexonEventTime_Check=cellfun(@(x,y) y(logical(x))',PlexonMatch,EventTime_AfterAlign_Plexon,'uniform',0);
          BlipEventTime_Check=cellfun(@(x,y) y(logical(x)),BlipMatch,EventTimeForAll,'uniform',0);
          EventTimeDifferenceCheck=cellfun(@(x,y) abs(x-y),PlexonEventTime_Check,BlipEventTime_Check,'uniform',0);
        %  A=cellfun(@max,EventTimeDifferenceCheck);
        %  B=TrialIndex_Plexon;
        %   C=[A,B];
           
          LargestTimeDescrepency=max(cellfun(@max,EventTimeDifferenceCheck));%in ms
          DescrepencyTolerance=5;%in ms, the maximum temporal descrepency between Blip events and the Plexon events
          %
          TrialWithLargestDesc = find(cellfun(@max,EventTimeDifferenceCheck)==LargestTimeDescrepency);
          DifferentEventTime = EventTimeDifferenceCheck{TrialWithLargestDesc};
          if length(TrialWithLargestDesc) > 0
              TrialWithLargestDesc=TrialWithLargestDesc(1);
          end
          CodeWithDesc = BlipEventCommon_Check{TrialWithLargestDesc}(DifferentEventTime ==LargestTimeDescrepency);
          
          if LargestTimeDescrepency>DescrepencyTolerance
              disp(sprintf('Error!!%d ms descrepency between Blip and Plexon,above %d ms please check where is wrong!!',LargestTimeDescrepency,DescrepencyTolerance));
              if TaskCode == VIDEO_FREEVIEW_TASK
                disp('Use Plexon Event Marker Instead');
                EventTimeForAll = cellfun(@(x) x',EventTime_AfterAlign_Plexon,'UniformOutput',0);
                EventCodeForAll = cellfun(@(x) x',Event_Plexon,'UniformOutput',0);
                
                EventCodeType = 2;
                
              else
                  if ismember(CodeWithDesc,[CORRECTCD,RWDOFFCD ] )
                      disp(sprintf('Code %1.0d mismatched!Still can continue',CodeWithDesc));

                      EventTimeForAll = cellfun(@(x) x',EventTime_AfterAlign_Plexon,'UniformOutput',0);
                    EventCodeForAll = cellfun(@(x) x',Event_Plexon,'UniformOutput',0);
                
                    EventCodeType = 2;

                  elseif ismember(CodeWithDesc,[TGTCD] )
                          disp(sprintf('Code %1.0d mismatched!No way to continue',CodeWithDesc));
                          return

                  else
                      return
                  end
                  
                
              end
          end
          %
          
          disp(sprintf('Largest temporal descrepency is %d ms',LargestTimeDescrepency));
          
          %Combine Plexon spikes with original spikes
          for i=1:size(SpikeTime_Extra,2)
              
          SpikeTime(:,PlexonStartingChannel+i-1)=SpikeTime_Extra{i};
          end
          %{
          %Packing the waveform sample to accomondate the old styles using
          %the median waveform
        %  WaveFormSampleNum=1000;
          NumOfFake=2;
          %SpikeWaveFormSample_Wform=cell2mat(cellfun(@(x) x(1:min(size(x,1),WaveFormSampleNum),:),SpikeWaveForm_Extra,'uniform',0)');
          
          SpikeWaveFormSample_Wform=SpikeWaveForm_Med;
          SpikeWaveFormSample_Num=size(SpikeWaveForm_Med,1);
         % SpikeWaveFormSample_Num=cell2mat(cellfun(@(x) min(size(x,1),WaveFormSampleNum),SpikeWaveForm_Extra,'uniform',0)');
         SpikeWaveFormSample_Num_Array=1:sum(SpikeWaveFormSample_Num)+NumOfFake;
       %   SpikeWaveFormSample_Num_Array=1:sum(SpikeWaveFormSample_Num)+NumOfFake;
          SpikeWaveFormSample_Type=-1*ones(sum(SpikeWaveFormSample_Num)+NumOfFake,1); %Add some fake data about the unsorted spikes
          for i=1:length(SpikeWaveFormSample_Num)
              SpikeWaveFormSample_Type((i-1)*SpikeWaveFormSample_Num(max(i-1,1))+1:i*SpikeWaveFormSample_Num(i))=-1+i;
    
          end
          %Add some fake data about the unsorted spikes
         SpikeWaveFormSample_Wform=[SpikeWaveFormSample_Wform;NaN*ones(NumOfFake,size(SpikeWaveFormSample_Wform,2))];
         SampleSR=SR*ones(sum(SpikeWaveFormSample_Num)+NumOfFake,1);
         
         SpikeWaveFormSample.Wform=SpikeWaveFormSample_Wform;
         SpikeWaveFormSample.SR=SampleSR;
         SpikeWaveFormSample.Num=SpikeWaveFormSample_Num_Array;
         SpikeWaveFormSample.Type=SpikeWaveFormSample_Type;
         %}
         
       else
           %Try to rescue with trialid
           %Match trial index from Blip and Plexon
          %TrialIndex_Plexon
           disp('TrialNum Dismatch!!!');
           msgbox('TrialNum Dismatch!!Please check the Plexon parsing manually!','PlexonParsingError','error');
       end
       
       
      
        
    end
    
    
    
end

 
 
 
 %Event Channel

MaxNumOfEvent=max(cellfun(@(x) numel(x),EventTimeForAll ));


EventTimeChannel=cell2mat(cellfun(@(x) [x,NaN*ones(1,MaxNumOfEvent-numel(x))],EventTimeForAll,'uniform',0))-EyeStartRecordTime;
EventDataChannel=cell2mat(cellfun(@(x) [x,NaN*ones(1,MaxNumOfEvent-numel(x))],EventCodeForAll,'uniform',0));
EventBinChannel=floor(EventTimeChannel*SamplingRate)+1;

%Spike Channel

if isempty(SpikeTime)
  
    SpikeTimeData=NaN*ones(max(size(EventTimeChannel,2),1),1,TotalTrials);
    SpikeBinData=NaN*ones(max(size(EventTimeChannel,2),1),1,TotalTrials);
    
    SpikeTimeDataPre=NaN*ones(max(size(EventTimeChannel,2),1),1,TotalTrials);
    SpikeBinDataPre=NaN*ones(max(size(EventTimeChannel,2),1),1,TotalTrials);
    
    
else
   
 
    SpikeTimeData=NaN*ones(max(size(SpikeTime,2),1),max(1,max(max(cellfun(@numel,SpikeTime))))+2,TotalTrials);%Add one to store the spike time start and end
    SpikeBinData=NaN*ones(max(size(SpikeTime,2),1),max(1,max(max(cellfun(@numel,SpikeTime))))+2,TotalTrials);%Add one to store the spike bin start and end
    
    
     SpikeTimeDataPre=NaN*ones(max(size(SpikeTime,2),1),max(1,max(max(cellfun(@numel,SpikeTime))))+2,TotalTrials);%Add one to store the spike time start and end
    SpikeBinDataPre=NaN*ones(max(size(SpikeTime,2),1),max(1,max(max(cellfun(@numel,SpikeTime))))+2,TotalTrials);%Add one to store the spike bin start and end
    

end



MaxPreLength=0;
 
 
for i=1:TotalTrials
%for i=12:12
   %{
    %AlignTime;
    currentEyeChanel=EyeData(i,:);
    if min(MaximumBinNum,cellfun(@numel,currentEyeChanel(1)))==MaximumBinNum
        TruncatedIndex=TruncatedIndex+1;
        TruncatedTrials=[TruncatedTrials,i];
    end
    %}
  %  EyeTimeChannel(i,1:min(MaximumBinNum,cellfun(@numel,currentEyeChanel(1))))=linspace(EyeDataTime(i,1),min(EyeDataTime(i,2),EyeDataTime(i,1)+TimeLimitsForOneTrial),min(MaximumBinNum,cellfun(@numel,currentEyeChanel(1))))-EyeStartRecordTime(i);
    %All time related channels are stored relative to the eye start record
    %time;Thus the eyetime channel stores the relative time for all;
    %{
    temp=cell2mat(currentEyeChanel(1));
    EyeChannel_X_L(i,1:min(MaximumBinNum,cellfun(@numel,currentEyeChanel(1))))=temp(1:min(MaximumBinNum,cellfun(@numel,currentEyeChanel(1))));
    temp=cell2mat(currentEyeChanel(2));
    EyeChannel_Y_L(i,1:min(MaximumBinNum,cellfun(@numel,currentEyeChanel(2))))=temp(1:min(MaximumBinNum,cellfun(@numel,currentEyeChanel(2))));
    temp=cell2mat(currentEyeChanel(3));
    EyeChannel_X_R(i,1:min(MaximumBinNum,cellfun(@numel,currentEyeChanel(3))))=temp(1:min(MaximumBinNum,cellfun(@numel,currentEyeChanel(3))));
    temp=cell2mat(currentEyeChanel(4));
    EyeChannel_Y_R(i,1:min(MaximumBinNum,cellfun(@numel,currentEyeChanel(4))))=temp(1:min(MaximumBinNum,cellfun(@numel,currentEyeChanel(4))));
    %}
    
 %   EventTimeChannel(i,1:cellfun(@numel,EventTimeForAll(i)))=cell2mat(EventTimeForAll(i))-EyeStartRecordTime(i);
 %   EventDataChannel(i,1:cellfun(@numel,EventCodeForAll(i)))=cell2mat(EventCodeForAll(i));
 %   EventBinChannel(i,1:cellfun(@numel,EventTimeForAll(i,:)))=floor((cell2mat(EventTimeForAll(i,:))-EyeStartRecordTime(i))*SamplingRate)+1;
    
    %Load the spiketimes
    if ~isempty(SpikeTime)
       for j=1:size(SpikeTimeData,1)
      
            SpikeTimeData(j,1:cellfun(@numel,SpikeTime(i,j)),i)=cell2mat(SpikeTime(i,j))-EyeStartRecordTime(i);
            
            
            tmp=ceil((cell2mat(SpikeTime(i,j))-EyeStartRecordTime(i))*SamplingRate)+1;
            SpikeBinData(j,1:length(tmp(tmp>0)),i)=tmp(tmp>0);
      
   %Add spike time end 
            SpikeTimeData(j,end-1:end,i)=[0,SpikeTimeEnd(i)];
            SpikeBinData(j,end-1:end,i)=[1,ceil(SpikeTimeEnd(i)*SamplingRate)+1];
   %Add pretask start spike timing
   %SpikeTime After trial end(Pretask spike for the next trial)
   if i<TotalTrials
      SpikeTime_temp=cell2mat(SpikeTime(i,j))-EyeStartRecordTime(i);
      
   
      SpikeTime_temp_pre=SpikeTime_temp(SpikeTime_temp>(TaskEnd(i)-EyeStartRecordTime(i)))-(EyeStartRecordTime(i+1)-EyeStartRecordTime(i));
      SpikeBin_temp_pre=floor(SpikeTime_temp_pre*SamplingRate)+1;
      
      
      SpikeTimeDataPre(j,1:length(SpikeTime_temp_pre),i+1)=SpikeTime_temp_pre;
      SpikeBinDataPre(j,1:length(SpikeBin_temp_pre),i+1)=SpikeBin_temp_pre;
      
      %Add start recording time and end recording time
     PreSpikeStartTime=TaskEnd(i)-EyeStartRecordTime(i+1);
     PreSpikeEndTime=0;
     PreSpikeStartBin=floor(PreSpikeStartTime*SamplingRate)+1;
     PreSpikeEndBin=1;
     
     SpikeTimeDataPre(j,end-1:end,i+1)=[PreSpikeStartTime,PreSpikeEndTime];
     SpikeBinDataPre(j,end-1:end,i+1)=[PreSpikeStartBin,PreSpikeEndBin];

      
      if MaxPreLength<length(SpikeTime_temp_pre)
          MaxPreLength=length(SpikeTime_temp_pre);
      end
      
      
   end
       end
    end
  
  
    
    %Put fractal name and scene name along with their ID
    if TaskCode==FORAGING_TASK || TaskCode==FORAGING_TASK_SEQ ||TaskCode==FORAGING_TASK_LOCSEQ 
       % GoodObjectLib=ParaLib_Whole('GoodObjectIDLib,GoodObjectName');
       % BadObjectLib=ParaLib_Whole('BadObjectIDLib,BadObjectName');
       % SceneLib=ParaLib_Whole('SceneIDLib,SceneName');
        
       %SceneAndObjectLib=[SceneLib,GoodObjectLib(:,2:end),BadObjectLib(:,2:end)];
       
       %First find out the block it belongs to (scene and fractals may change in different blocks)
      
        if ~ImageAssociationIndex %After 02142020, I don't need it anymore  
       BlockIntervals=unique(SceneAndObjectLib(:,1)); 
      
         if sum(BlockIntervals==i)
          currentBlock=find(BlockIntervals==i);
         else
          currentBlock=find(sort([BlockIntervals;i])==i)-1;
          currentBlock=max(currentBlock,1);
           
         end
     
        
       
       currentLib=SceneAndObjectLib(SceneAndObjectLib(:,1)==BlockIntervals(currentBlock),2:end);
       currentLib=[currentLib(:,1:2);currentLib(:,3:4);currentLib(:,5:6)];
       MaximumLib=100;
       linelib=NaN*ones(1,max(currentLib(:,1)));
       linelib(currentLib(:,1))=currentLib(:,2);%Set up a line library where the index is the same as the 
       
       TargetIndexCurrent=TargetIndex(TargetIndex(:,1)==i,2);
       SceneIndexCurrent=SceneIndex(SceneIndex(:,1)==i,2);
       
          if max(max(TargetIndexCurrent),SceneIndexCurrent)>size(linelib,2)
           disp('Rescue Target Index Library using default settings');
           linelib=[linelib,NaN*ones(1,MaximumLib-size(linelib,2))];
           if TaskCode==FORAGING_TASK
               if length(unique(SceneIndex(:,2)))==6
                   
                 linelib(FIRST_SCENE:TWELVETH_SCENE)=[1040:1047,1050:1053];
                 linelib(FIRSTGOOD:2:TWELVETHGOOD)=[1580:1583,1590:1593,1600:1603];
                 linelib(FIRSTBAD:2:TWELVETHBAD)=[1584:1587,1594:1597,1604:1607];
               elseif length(unique(SceneIndex(:,2)))==12
                 linelib(FIRST_SCENE:TWELVETH_SCENE)=[1000:1007,1010:1013];
                 linelib(FIRSTGOOD:2:TWELVETHGOOD)=[1500:1503,1510:1513,1520:1523];
                 linelib(FIRSTBAD:2:TWELVETHBAD)=[1504:1507,1514:1517,1524:1527];
    
               end
               
           elseif TaskCode==FORAGING_TASK_SEQ
               
                 linelib(FIRST_SCENE:TWELVETH_SCENE)=[1024:1027,1034:1037,1030:1033];
                 linelib(FIRSTGOOD:2:TWELVETHGOOD)=[1550:1553,1560:1563,1570:1573];
                 linelib(FIRSTBAD:2:TWELVETHBAD)=[1554:1557,1564:1567,1574:1577]; 
               
               
               
           end
           
           
          end
          
           TargetIndex(ismember(TargetIndex(:,1),i),3)=linelib(TargetIndexCurrent)';
           SceneIndex(ismember(SceneIndex(:,1),i),3)=linelib(SceneIndexCurrent)';
       end
        
    end
   
    
 
end
 
%Shorten the matrix, leave 2 NaNs to separate start and end time
SpikeTimeDataPre=SpikeTimeDataPre(:,[1:MaxPreLength+2,end-2:end],:);
SpikeBinDataPre=SpikeBinDataPre(:,[1:MaxPreLength+2,end-2:end ],:);


 
GoodData.Header="These data are only from correct trials, except for the bonus data; All the time channels are aligned with the eye start record time!";
GoodData.FileName=Raw.FileName;
