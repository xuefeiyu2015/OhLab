PSTH_TgtOn_Bad_RF_PV_Sig_Good = PSTH_TgtOn_Bad_RF_PV(Good_sel_PV,:);

PSTH_TgtOn_Good_RF_PV_Sig_Bad = PSTH_TgtOn_Good_RF_PV(Bad_sel_PV,:);
PSTH_TgtOn_Bad_RF_PV_Sig_Bad = PSTH_TgtOn_Bad_RF_PV(Bad_sel_PV,:);



PSTH_TgtOn_Good_RF_PV_Sig_Good_Mean=mean(PSTH_TgtOn_Good_RF_PV_Sig_Good,1);
