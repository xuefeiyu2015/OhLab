x_fit_inconsistent = linspace(min(Absolute_ROC_stable_BothInConsistent2), max(Absolute_ROC_stable_BothInConsistent2), 100);
y_fit_inconsistent = polyval(p_inconsistent, x_fit_inconsistent);
plot(x_fit_inconsistent, y_fit_inconsistent, '-b', 'LineWidth', 2); % Blue line for inconsistent group

[r_inconsistent2,p_inconsistent2] = corr(Absolute_ROC_stable_BothInConsistent2', Absolute_ROC_oneDR_BothInConsistent2','Type', 'Pearson');


% Labels and title
