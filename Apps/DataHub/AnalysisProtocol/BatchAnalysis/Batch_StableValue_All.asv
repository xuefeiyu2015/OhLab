PSTH_TgtOn_Good_RF_PV_Sig_Good_Sem=std(PSTH_TgtOn_Good_RF_PV_Sig_Good,[],1)/sqrt(sum(Good_sel_PV));
PSTH_TgtOn_Bad_RF_PV_Sig_Good_Sem=std(PSTH_TgtOn_Bad_RF_PV_Sig_Good,[],1)/sqrt(sum(Good_sel_PV));

PSTH_TgtOn_Good_RF_PV_Sig_Bad_Mean=mean(PSTH_TgtOn_Good_RF_PV_Sig_Bad,1);
PSTH_TgtOn_Bad_RF_PV_Sig_Bad_Mean=mean(PSTH_TgtOn_Bad_RF_PV_Sig_Bad,1);

PSTH_TgtOn_Good_RF_PV_Sig_Bad_Sem=std(PSTH_TgtOn_Good_RF_PV_Sig_Bad,[],1)/sqrt(sum(Bad_sel_PV));
