 %Scatter plot for both objects
FigureStartNum = FigureStartNum+1;
FigureIndex = FigureIndex+1;
figtitlestr{FigureIndex}='ScatterPlots_Both';
fig{FigureIndex}=PrepareFigure(FigureStartNum,'w',[50,100, 600,600],'Name',figtitlestr{FigureIndex});
 
scatter(Absolute_ROC_stable_BothConsistent,Absolute_ROC_oneDR_BothConsistent,'or','filled')
hold on 
scatter(Absolute_ROC_stable_BothInConsistent,Absolute_ROC_oneDR_BothInConsistent,'ob','filled')
%Fittings
% Fit a line for "Both Consistent"
p_consistent = polyfit(Absolute_ROC_stable_BothConsistent, Absolute_ROC_oneDR_BothConsistent, 1);
x_fit_consistent = linspace(min(Absolute_ROC_stable_BothConsistent), max(Absolute_ROC_stable_BothConsistent), 100);
y_fit_consistent = polyval(p_consistent, x_fit_consistent);
plot(x_fit_consistent, y_fit_consistent, '-r', 'LineWidth', 2); % Red line for consistent group

% Fit a line for "Both Inconsistent"
p_inconsistent = polyfit(Absolute_ROC_stable_BothInConsistent, Absolute_ROC_oneDR_BothInConsistent, 1);
x_fit_inconsistent = linspace(min(Absolute_ROC_stable_BothInConsistent), max(Absolute_ROC_stable_BothInConsistent), 100);
y_fit_inconsistent = polyval(p_inconsistent, x_fit_inconsistent);
plot(x_fit_inconsistent, y_fit_inconsistent, '-b', 'LineWidth', 2); % Blue line for inconsistent group

% Labels and title
xlabel('Absolute ROC Stable');
ylabel('Absolute ROC OneDR');
title('Scatter Plot for neurons modulated both values');
legend({'Consistent', 'Both Inconsistent', 'Fit: Consistent', 'Fit: Inconsistent'}, 'Location', 'best');


xlabel('Object abs AUC');
ylabel('Location abs AUC');
legend({'Cons','InConsis'})

