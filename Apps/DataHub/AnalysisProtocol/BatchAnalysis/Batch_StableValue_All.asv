FigureStartNum = FigureStartNum+1;
FigureIndex = FigureIndex+1;
figtitlestr{FigureIndex}='ScatterPlots_Both2';
fig{FigureIndex}=PrepareFigure(FigureStartNum,'w',[50,100, 600,600],'Name',figtitlestr{FigureIndex});
 
scatter(Absolute_ROC_stable_BothConsistent2,Absolute_ROC_oneDR_BothConsistent2,100,'ob','filled','MarkerEdgeColor',[0,0,0],'LineWidth',2)
hold on 
scatter(Absolute_ROC_stable_BothInConsistent2,Absolute_ROC_oneDR_BothInConsistent2,100,'og','filled','MarkerEdgeColor',[0,0,0],'LineWidth',2)
%Fittings
% Fit a line for "Both Consistent"
p_consistent = polyfit(Absolute_ROC_stable_BothConsistent2, Absolute_ROC_oneDR_BothConsistent2, 1);
x_fit_consistent = linspace(min(Absolute_ROC_stable_BothConsistent2), max(Absolute_ROC_stable_BothConsistent2), 100);
y_fit_consistent = polyval(p_consistent, x_fit_consistent);
plot(x_fit_consistent, y_fit_consistent, '-r', 'LineWidth', 2); % Red line for consistent group
[r_consistent2,p_consistent2] = corr(Absolute_ROC_stable_BothConsistent2', Absolute_ROC_oneDR_BothConsistent2','Type', 'Pearson');

%r_consistent2
%p_consistent2

% Fit a line for "Both Inconsistent"
