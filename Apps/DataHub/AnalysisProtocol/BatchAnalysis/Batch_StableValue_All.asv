% Passive Viewing Task

AUCPSTH_TgtOn_RF_PV=cell2mat(AUCPSTH_TgtOn_Value_RF_PV');


AUCPSTH_TgtOn_RF_PV_Sig_Good = AUCPSTH_TgtOn_RF_PV(Good_sel_PV,:);
AUCPSTH_TgtOn_RF_PV_Sig_Bad = AUCPSTH_TgtOn_RF_PV(Bad_sel_PV,:);



AUCPSTH_TgtOn_RF_PV_Sig_Good_mean=nanmean(AUCPSTH_TgtOn_RF_PV_Sig_Good,1);
